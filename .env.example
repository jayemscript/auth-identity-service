
# ===== Application =====
PORT=7000
NODE_ENV=development
# The BFF forwards the resolved client IP to this private service. Keep the
# auth service reachable only by trusted BFFs when trusting this one hop.
TRUST_PROXY_HOPS=1

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=root
DB_NAME=auth_db
DB_SSL=false

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===== CORS Configuration =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ===== Cookie Configuration =====
COOKIE_SECRET=your_super_secret_cookie_key_min_32_chars
COOKIE_SAMESITE=lax # Options: 'lax', 'strict', 'none'
COOKIE_EXPIRATION=2592000000
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

# ===== JWT Configuration =====
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=2592000
JWT_ALGORITHM=HS256


#=====SUPER-ADMIN=====
SUPERADMINEMAIL=superadmin@mail.com
SUPERADMINPASSWORD=@SuperAdmin000